+void VU1Interpreter::runFast(uint8_t *vuCode, uint32_t codeSize,
+                             uint8_t *vuData, uint32_t dataSize,
+                             GS &gs, PS2Memory *memory, uint32_t maxCycles, bool recompiled)
+{
+    const int previousRoundingMode = std::fegetround();
+    const bool useVuRounding = std::fesetround(FE_TOWARDZERO) == 0;
+    const uint64_t budgetEnd = m_cycle + maxCycles;
+    VuReservedDiag &diag = g_vuReservedDiag[m_unit == Unit::VU1 ? 1 : 0];
+    bool programEnded = false;
+    if (m_cycle < budgetEnd && !m_stopRequested)
+        commitReadyPipelines();
+
+    RecompiledImage image = nullptr;
+#if defined(PS2X_VU1_RECOMPILED_AVAILABLE)
+    if (recompiled)
+    {
+        if (!m_recompiledImageResolved)
+        {
+            m_recompiledImage = VuRecompiled::find(imageHash(vuCode, codeSize), m_unit == Unit::VU1 ? 1u : 0u);
+            if (!m_recompiledImage)
+                m_recompiledImage = VuRecompiled::findPrefix(vuCode, codeSize, m_unit == Unit::VU1 ? 1u : 0u);
