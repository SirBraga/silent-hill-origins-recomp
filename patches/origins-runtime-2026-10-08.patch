+    int IopKernel::spawnThread(uint32_t entry, uint32_t a0, uint32_t a1, uint32_t a2, uint32_t gp,
+                               uint32_t priority, uint32_t stackTop)
+    {
+        IopThread thread;
+        thread.id = static_cast<int>(m_nextThreadId++);
+        thread.entry = entry;
+        thread.priority = priority;
+        thread.initialPriority = priority;
+        thread.cpu = {};
+        thread.cpu.pc = entry;
+        thread.cpu.gpr[4] = a0;
+        thread.cpu.gpr[5] = a1;
+        thread.cpu.gpr[6] = a2;
+        thread.cpu.gpr[28] = gp;
+        thread.cpu.gpr[29] = (stackTop & ~15u) - 16u;
+        thread.cpu.gpr[31] = kThreadReturnSentinel;
+        thread.state = IopThreadState::Ready;
+        const int id = thread.id;
+        m_threads.emplace(id, std::move(thread));
+        return id;
+    }
+
+    const IopThread *IopKernel::findThread(int id) const
+    {
+        const auto it = m_threads.find(id);
+        return it == m_threads.end() ? nullptr : &it->second;
+    }
+
+    void IopKernel::destroyThread(int id)
+    {
+        const auto it = m_threads.find(id);
+        if (it == m_threads.end())
+            return;
+        if (m_currentThread == &it->second)
+            m_currentThread = nullptr;
+        if (it->second.stackBase != 0u)
+            (void)m_memory.freeAllocation(it->second.stackBase);
+        m_threads.erase(it);
+    }
